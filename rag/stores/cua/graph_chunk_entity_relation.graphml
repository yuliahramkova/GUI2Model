    <node id="product_add_to_cart">
      <data key="d0">product_add_to_cart</data>
      <data key="d1">task</data>
      <data key="d2">A task with ID 'product_add_to_cart' that involves adding a product to the cart and navigating through the cart dropdown.&lt;SEP&gt;A task with the ID 'product_add_to_cart' that involves clicking 'Add to Cart' on a product page.&lt;SEP&gt;A task with ID 'product_add_to_cart' that involves clicking Add to Cart on a product page.&lt;SEP&gt;A procedure for adding a product to the cart.&lt;SEP&gt;A task with ID 'product_add_to_cart' that involves adding a product to the cart.&lt;SEP&gt;A task with the ID 'product_add_to_cart' that involves clicking Add to Cart on a product page, waiting for a spinner, opening the minicart dropdown, and navigating to the shopping cart.</data>
      <data key="d3">doc-0b82f2664c7109af07ee7d643c47aeb3-chunk-000&lt;SEP&gt;doc-62d9053cf6071c97f1a27f1d4e29dbec-chunk-000&lt;SEP&gt;doc-a308514bccdf13f38fc2e196ba602317-chunk-000&lt;SEP&gt;doc-d73a8809013d6a5b52c991960b728802-chunk-000&lt;SEP&gt;doc-dd334441a53ee71d815874e2a4d2f7c9-chunk-000&lt;SEP&gt;doc-3f379752fbd26977545a0317836cb0a9-chunk-000</data>
