    <node id="action">
      <data key="d0">action</data>
      <data key="d1">other</data>
      <data key="d2">The action performed during the task.&lt;SEP&gt;The specific action taken during the task.&lt;SEP&gt;An action taken during a process.&lt;SEP&gt;An operation or maneuver executed during a task.&lt;SEP&gt;An operation or action taken during a process.&lt;SEP&gt;The specific action taken during a task.&lt;SEP&gt;An operation performed during a task.</data>
